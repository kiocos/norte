{
  "name": "norte-mapa-carreiras",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "npm run data:publish",
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "prebuild": "npm run data:publish",
    "build": "next build",
    "start": "node scripts/serve-local.mjs",
    "pretypecheck": "npm run data:publish",
    "typecheck": "tsc --noEmit",
    "data:fetch": "python3 scripts/fetch_data.py",
    "data:normalize": "python3 scripts/normalize.py",
    "data:publish": "node scripts/export-data.mjs",
    "pretest": "npm run data:publish",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "d3-hierarchy": "^3.1.2",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.10",
    "serve-handler": "^6.1.7",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": "24.x"
  }
}
